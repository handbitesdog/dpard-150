# Android Google Maps SDK key, used by app.config.ts (android.config.googleMaps.apiKey).
# Create one in Google Cloud Console with the "Maps SDK for Android" enabled,
# restricted to this app's package name (gov.dallascityhall.parks) and debug/release
# signing certificate fingerprints.
GOOGLE_MAPS_API_KEY=

# Origin of the static host serving park photography, stamp art, guide audio, and the
# Connect feed — no trailing slash, http(s) only. Optional: leave it empty and the app
# falls back to bundled placeholder art and the bundled audio fixture, and skips the feed
# fetch entirely. See "Content CDN" in README.md for the expected paths. Inlined by Metro
# at build time, so changes need `expo start --clear`.
EXPO_PUBLIC_CDN_BASE_URL=
